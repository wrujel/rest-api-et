{
  "name": "rest-api-et",
  "version": "1.0.0",
  "description": "REST API built with Express, TypeScript and MongoDB, served alongside an Angular dashboard.",
  "private": true,
  "license": "ISC",
  "author": "W. Rujel",
  "main": "dist/index.js",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:ui": "pnpm --filter angular run build",
    "build:all": "pnpm run build:ui && pnpm run build",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "dev:ui": "pnpm --filter angular run watch",
    "dev:all": "concurrently -k -n api,ui \"pnpm:dev\" \"pnpm:dev:ui\"",
    "typecheck": "tsc -p tsconfig.check.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "pnpm --filter angular run test",
    "test:ui:coverage": "pnpm --filter angular run test:coverage",
    "test:all": "pnpm run test:coverage && pnpm run test:ui:coverage",
    "audit": "pnpm audit --prod --audit-level=low",
    "test:ci": "vitest run --coverage --reporter=default --reporter=json --outputFile=.vitest.json",
    "test:ui:ci": "pnpm --filter angular run test:ci"
  },
  "keywords": [
    "express",
    "typescript",
    "mongodb",
    "angular",
    "rest-api"
  ],
  "dependencies": {
    "argon2": "^0.45.1",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.9.4",
    "passport": "^0.7.0",
    "passport-github2": "^0.1.12",
    "passport-google-oauth20": "^2.0.0"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.4.0",
    "@types/passport": "^1.0.17",
    "@types/passport-github2": "^1.2.9",
    "@types/passport-google-oauth20": "^2.0.17",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^4.1.11",
    "concurrently": "^10.0.5",
    "supertest": "^7.2.2",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
