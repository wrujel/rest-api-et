# Copy to .env for local development. On Render/Vercel these are set in the
# dashboard instead — no .env file is deployed.

# MongoDB connection string (required).
MONGO_URL=mongodb://127.0.0.1:27017/rest-api-et

# Signing secrets for the access and refresh JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# HMAC pepper for the pre-JWT password scheme. Only needed while accounts
# created before the argon2 migration still exist; login migrates them on the
# next successful sign-in.
SECRET=

# Set to "production" so the refresh cookie is marked Secure. Any other value
# (or none) keeps it readable over plain HTTP for local development.
ENVIRONMENT=development

# Where the built Angular dashboard lives, relative to the process cwd. Leave
# unset on Vercel: the CDN serves the static build and the function only
# answers /api/*.
FRONTEND_BUILD_PATH=frontend/angular/dist

# Port for the local server. Defaults to 8080.
PORT=8080

# Public origin of this API, used to build the OAuth callback URLs.
API_PUBLIC_URL=http://localhost:8080

# Allowed browser origin. Unset means "reflect whatever origin asked", which is
# right when the API and the dashboard are served from one host.
# CORS_ORIGIN=https://example.com

# OAuth apps. A provider is offered to the browser only when BOTH halves of its
# pair are present; leave them blank to hide that button.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
